{
  "name": "dsh-tool-monitor",
  "version": "0.1.0",
  "description": "Event-driven monitoring for existing DeepSeek Harness background jobs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoke233/dsh-tool-monitor.git"
  },
  "homepage": "https://github.com/yoke233/dsh-tool-monitor#readme",
  "bugs": {
    "url": "https://github.com/yoke233/dsh-tool-monitor/issues"
  },
  "keywords": ["deepseek-harness", "dsh-plugin", "background-job", "monitor", "bash", "powershell"],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./registry": { "types": "./lib/registry.d.ts", "default": "./lib/registry.js" },
    "./tool": { "types": "./lib/tool.d.ts", "default": "./lib/tool.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "assets/readme/hero.svg", "cordis.patch.yml", "DESIGN.md", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-jobs-local": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-jobs-local": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-jobs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
